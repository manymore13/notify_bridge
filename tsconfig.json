{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/test.ts", "src/integration-test.ts", "src/e2e-test.ts", "src/sdk-test.ts", "src/feishu-test.ts", "src/feishu-lookup.ts", "src/find-openid.ts"]
}
